# =================================================================
# Antigravity IDE Clone — Environment Configuration (BYOK)
# Copy this file to .env.local and add your own API keys.
# DO NOT COMMIT .env.local to git.
# =================================================================

# Google AI Studio / Gemini API Keys (BYOK - Free & Pay-as-you-go)
# Generate at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY_PRIMARY=
GOOGLE_AI_API_KEY_BACKUP=

# Anthropic Claude API Keys (BYOK)
# Generate at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY_PRIMARY=
ANTHROPIC_API_KEY_BACKUP=

# OpenAI API Keys (BYOK)
# Generate at: https://platform.openai.com/api-keys
OPENAI_API_KEY_PRIMARY=

# Custom / Self-hosted LLM Endpoint (e.g. Ollama, vLLM, OpenRouter, LM Studio)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Local Engine & Database Storage Path
AGY_STORAGE_PATH=./data/agy-clone
AGY_TURBO_MODE_DEFAULT=true
