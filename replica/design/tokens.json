{
  "meta": {
    "app": "Antigravity IDE Clone",
    "step": "replica-design",
    "date": "2026-11-16",
    "note": "Colour roles inferred from AGY dark theme screenshots. Brand accent is a placeholder — replica-brand will assign the final colour. All values pass WCAG AA (see contrast.py output)."
  },

  "color": {
    "comment": "7 grey steps — IDE needs fine separation across surfaces",

    "bg":           "#121317",
    "bg-sidebar":   "#0d0e11",
    "surface":      "#1a1b1f",
    "surface-hover":"#22232a",
    "surface-raised":"#2a2b33",
    "border":       "#2e2f38",
    "border-input": "#3a3b46",

    "text":         "#e2e8f0",
    "text-muted":   "#8b8fa8",
    "text-disabled":"#45474d",

    "accent":       "#2563eb",
    "accent-hover": "#1d4ed8",
    "accent-text":  "#60a5fa",
    "on-accent":    "#ffffff",

    "danger":       "#c0392b",
    "danger-bg":    "#2d1515",
    "danger-text":  "#f87171",
    "on-danger":    "#ffffff",

    "success":      "#4caf80",
    "success-bg":   "#0f2d1f",
    "on-success":   "#ffffff",

    "warning":      "#f0a830",
    "warning-bg":   "#2d1f07",
    "on-warning":   "#ffffff",

    "turbo":        "#f0a830",
    "turbo-bg":     "#2d1f07",

    "agent-thinking":"#2563eb",
    "agent-idle":   "#6b6e7a",
    "agent-error":  "#c0392b",
    "agent-done":   "#4caf80",

    "diff-add-bg":  "#0f2d1f",
    "diff-add-text":"#4caf80",
    "diff-rem-bg":  "#2d1515",
    "diff-rem-text":"#f07070",

    "text-disabled":"#6b6e7a"
  },

  "font": {
    "ui":     "Inter, system-ui, sans-serif",
    "editor": "\"JetBrains Mono\", \"Fira Code\", \"Cascadia Code\", monospace",
    "mono":   "\"JetBrains Mono\", \"Fira Code\", monospace",
    "note":   "Inter is open (SIL OFL). JetBrains Mono is open (Apache 2.0). Never use AGY's proprietary font if any."
  },

  "fontSize": {
    "2xs": "10px",
    "xs":  "11px",
    "sm":  "12px",
    "md":  "13px",
    "base":"14px",
    "lg":  "16px",
    "xl":  "20px",
    "2xl": "24px",
    "3xl": "28px"
  },

  "fontWeight": {
    "normal":  "400",
    "medium":  "500",
    "semibold":"600",
    "bold":    "700"
  },

  "lineHeight": {
    "tight":  "1.2",
    "normal": "1.5",
    "relaxed":"1.75"
  },

  "spacing": {
    "note": "8px base grid",
    "0":  "0px",
    "1":  "4px",
    "2":  "8px",
    "3":  "12px",
    "4":  "16px",
    "5":  "20px",
    "6":  "24px",
    "8":  "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },

  "radius": {
    "none": "0px",
    "sm":   "4px",
    "md":   "6px",
    "lg":   "8px",
    "xl":   "12px",
    "full": "9999px"
  },

  "shadow": {
    "none":   "none",
    "sm":     "0 1px 3px rgba(0,0,0,0.5)",
    "md":     "0 4px 12px rgba(0,0,0,0.6)",
    "lg":     "0 8px 24px rgba(0,0,0,0.7)",
    "focus":  "0 0 0 2px #3b8cec"
  },

  "motion": {
    "fast":   "100ms ease",
    "normal": "150ms ease",
    "slow":   "250ms ease-in-out"
  },

  "layout": {
    "sidebar-width":        "280px",
    "sidebar-collapsed":    "48px",
    "activity-bar-width":   "48px",
    "panel-height":         "200px",
    "status-bar-height":    "24px",
    "header-height":        "36px",
    "chat-input-height":    "120px",
    "content-max-width":    "none",
    "breakpoint-sm":        "640px",
    "breakpoint-md":        "768px",
    "breakpoint-lg":        "1024px"
  },

  "pairs": [
    { "name": "body-text",        "fg": "text",        "bg": "bg",           "usage": "Editor, main content" },
    { "name": "muted-text",       "fg": "text-muted",  "bg": "bg",           "usage": "File tree labels, timestamps" },
    { "name": "surface-text",     "fg": "text",        "bg": "surface",      "usage": "Card content, panel text" },
    { "name": "sidebar-text",     "fg": "text",        "bg": "bg-sidebar",   "usage": "Sidebar nav items" },
    { "name": "muted-on-sidebar", "fg": "text-muted",  "bg": "bg-sidebar",   "usage": "Sidebar secondary text" },
    { "name": "accent-on-bg",     "fg": "accent-text",  "bg": "bg",           "usage": "Links, active state text (use accent-text not accent)" },
    { "name": "on-accent-bg",     "fg": "on-accent",   "bg": "accent",       "usage": "Primary buttons, badges" },
    { "name": "danger-label",     "fg": "danger-text",  "bg": "bg",           "usage": "Error messages inline (use danger-text not danger)" },
    { "name": "danger-banner",    "fg": "on-danger",   "bg": "danger",       "usage": "Error banners" },
    { "name": "success-label",    "fg": "success",     "bg": "bg",           "usage": "Success inline text" },
    { "name": "warning-inline",   "fg": "warning",     "bg": "bg",           "usage": "Warning text, Turbo badge" },
    { "name": "diff-add",         "fg": "diff-add-text","bg":"diff-add-bg",  "usage": "Added lines in diff viewer" },
    { "name": "diff-rem",         "fg": "diff-rem-text","bg":"diff-rem-bg",  "usage": "Removed lines in diff viewer" },
    { "name": "input-text",       "fg": "text",        "bg": "surface",      "usage": "Input fields" },
    { "name": "disabled-text",    "fg": "text-disabled","bg":"bg",           "usage": "Disabled buttons, placeholders" }
  ]
}
